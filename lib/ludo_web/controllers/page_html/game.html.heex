<main class="page game-page" id="game" data-page="game" data-code={@code}>
  <header class="game-header">
    <a href={~p"/"} class="back">← Accueil</a>
    <h1>
      Salon <span class="code">{@code}</span>
      <span class="mode-tag">{@lobby.mode_label}</span>
    </h1>
    <button
      id="sound"
      class="secondary small"
      type="button"
      aria-pressed="true"
      title="Couper ou remettre le bruitage"
    >
      Son activé
    </button>
    <button
      id="emoji-open"
      class="secondary small"
      type="button"
      aria-haspopup="dialog"
      aria-controls="emoji-modal"
      title="Envoyer une réaction"
    >
      😀 Réagir
    </button>
    <button id="copy-link" class="secondary small" type="button">Copier le lien</button>
  </header>

  <div class="game-layout">
    <div class="board-wrap">
      <canvas id="board3d" role="img" aria-label="Plateau de Ludo"></canvas>
      <div class="banner" id="banner" hidden></div>

      <%!-- Réactions des joueurs : elles s'affichent deux secondes puis
           disparaissent. La couche n'est jamais reconstruite, un changement
           d'état ne peut donc pas effacer une réaction en cours. --%>
      <div class="reactions" id="reactions" aria-live="polite"></div>
      <p class="webgl-error" id="webgl-error" hidden>
        Votre navigateur ne peut pas afficher le plateau (WebGL indisponible).
      </p>
    </div>

    <aside class="side">
      <ul class="players" id="players"></ul>

      <%!-- Choix du camp, tant que la partie n'a pas démarré --%>
      <div class="camps" id="camps" hidden>
        <p class="camps-title">Votre camp</p>
        <div class="camps-row" id="camps-row"></div>
      </div>

      <div class="dice-panel">
        <p class="turn" id="turn">En attente…</p>

        <button
          class="dice"
          id="dice"
          type="button"
          aria-live="polite"
          aria-label="Lancer le dé"
          disabled
        ></button>

        <p class="hint" id="hint"></p>

        <button id="fill-bots" class="secondary small" type="button" hidden>
          Compléter avec des IA
        </button>
      </div>
    </aside>
  </div>

  <div class="modal" id="ask-name" hidden>
    <form class="card" id="ask-name-form">
      <h2>Rejoindre la partie</h2>
      <label class="field">
        <span>Votre pseudo</span>
        <input id="ask-pseudo" type="text" maxlength="18" placeholder="Camille" />
      </label>
      <button class="primary" type="submit">Entrer dans le salon {@code}</button>
    </form>
  </div>

  <%!-- Choix de la réaction : une feuille modale, fermée par Échap, par un clic
       à côté ou par le bouton. --%>
  <div class="emoji-modal" id="emoji-modal" hidden>
    <div
      class="emoji-sheet"
      role="dialog"
      aria-modal="true"
      aria-labelledby="emoji-title"
    >
      <p class="emoji-title" id="emoji-title">Votre réaction</p>
      <div class="emoji-grid" id="emoji-grid"></div>
      <button id="emoji-close" class="secondary small" type="button">Fermer</button>
    </div>
  </div>

  <div class="toast" id="toast" hidden></div>
</main>
