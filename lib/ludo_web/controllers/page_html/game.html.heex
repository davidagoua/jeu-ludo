<main class="page game-page" id="game" data-page="game" data-code={@code}>
  <header class="game-header">
    <a href={~p"/"} class="back">← Accueil</a>
    <h1>
      Salon <span class="code">{@code}</span>
      <span class="mode-tag">{@lobby.mode_label}</span>
    </h1>
    <button id="copy-link" class="secondary small" type="button">Copier le lien</button>
  </header>

  <div class="game-layout">
    <div class="board-wrap">
      <canvas id="board3d" role="img" aria-label="Plateau de Ludo en 3D"></canvas>
      <div class="banner" id="banner" hidden></div>
      <p class="webgl-error" id="webgl-error" hidden>
        Votre navigateur ne peut pas afficher la 3D (WebGL indisponible).
      </p>
    </div>

    <aside class="side">
      <ul class="players" id="players"></ul>

      <div class="dice-panel">
        <p class="turn" id="turn">En attente…</p>

        <button
          class="dice"
          id="dice"
          type="button"
          aria-live="polite"
          aria-label="Lancer le dé"
          disabled
        ></button>

        <p class="hint" id="hint"></p>

        <button id="fill-bots" class="secondary small" type="button" hidden>
          Compléter avec des IA
        </button>
      </div>
    </aside>
  </div>

  <div class="modal" id="ask-name" hidden>
    <form class="card" id="ask-name-form">
      <h2>Rejoindre la partie</h2>
      <label class="field">
        <span>Votre pseudo</span>
        <input id="ask-pseudo" type="text" maxlength="18" placeholder="Camille" />
      </label>
      <button class="primary" type="submit">Entrer dans le salon {@code}</button>
    </form>
  </div>

  <div class="toast" id="toast" hidden></div>
</main>
