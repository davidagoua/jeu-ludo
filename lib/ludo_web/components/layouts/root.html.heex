<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Ludo multijoueur en ligne : jouez à 2, 3 ou 4, ou contre l'IA. Aucun compte, juste un pseudo."
    />
    <title>{assigns[:page_title] || "Ludo"} · Ludo</title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="stylesheet" href={~p"/assets/css/ludo.css"} />
    <script defer type="text/javascript" src={~p"/assets/js/phoenix.min.js"}>
    </script>
    <script defer type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
